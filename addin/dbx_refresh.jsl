// "Refresh from Databricks" table script: re-run the saved query into this data table.
// The query runs first; rows are replaced only if it succeeds, so a failed refresh never loses data.
Names Default To Here( 1 );
Include( "dbx_common.jsl" );

dt = Current Data Table();
If( !dbx:ensurePython( 0 ), Stop() );

args = Associative Array();
args["table"] = dt << Get Name;
args["host"] = dt << Get Table Variable( "Databricks Host" );
args["warehouse_id"] = dt << Get Table Variable( "Databricks Warehouse" );
args["sql"] = dt << Get Table Variable( "Databricks Source" );
args["sign_in"] = dt << Get Table Variable( "Databricks Sign-in" );

// A shared .jmp file can carry any SQL: show it before it runs with your sign-in.
key = dbx:trustKey( args["host"], args["warehouse_id"], args["sql"] );
If( !Contains( dbx:trusted, key ),
	If( !dbx:confirm( "Refresh from Databricks",
			V List Box(
				Text Box( "Run this query with your Databricks sign-in?", <<Set Font Style( "Bold" ) ),
				Text Box( "Workspace: " || args["host"] || "\!nWarehouse: " || args["warehouse_id"], <<Set Wrap( 460 ) ),
				Text Box( args["sql"], <<Set Wrap( 460 ), <<Set Font( "Courier New" ) )
			),
			"Run"
		),
		Stop()
	);
	dbx:trusted[key] = 1;
);

r = dbx:call( "refresh_table", args );
If( Is Empty( r ),
	If( dbx:confirm( "Refresh from Databricks",
			V List Box(
				Text Box( "This table couldn't be refreshed. Its data was not changed.", <<Set Font Style( "Bold" ) ),
				Text Box( dbx:lastError, <<Set Wrap( 460 ) ),
				Text Box( "If your sign-in expired, sign in again, then run Refresh from Databricks again.", <<Set Wrap( 460 ) )
			),
			"Sign in…"
		),
		Include( "databricks_connector.jsl" )
	);
,
	dbx:finishTable( dt, r );
	Write( "\!nDatabricks Connector: refreshed " || Char( r["rows"] ) || " rows into " || r["table"] );
);
