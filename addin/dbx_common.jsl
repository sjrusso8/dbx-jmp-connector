// Shared by databricks_connector.jsl (the window) and dbx_refresh.jsl (a data table's Refresh script).
If( !Namespace Exists( "dbx" ), New Namespace( "dbx" ) ); // keep state: a refresh can run while the window is open

dbx:addinDir = Try(
	Convert File Path( "$ADDIN_HOME(com.databricks.jmp.connector)", Native ),
	Convert File Path( Get Default Directory(), Native )
);

dbx:navy = RGB Color( 0.106, 0.192, 0.224 );
dbx:lava = RGB Color( 1, 0.212, 0.129 );
dbx:muted = RGB Color( 0.42, 0.45, 0.48 );

// fresh = 1 (window open): reload dbx_jmp and start a new log. fresh = 0 (refresh): keep the signed-in session.
dbx:loadPython = Function( {fresh},
	Python Submit( Eval Insert( "\[
import sys, importlib, logging
if r"^dbx:addinDir^" not in sys.path:
    sys.path.insert(0, r"^dbx:addinDir^")
try:
    import databricks.sdk, databricks.sql, pyarrow
    import dbx_jmp
    if ^fresh^:
        importlib.reload(dbx_jmp)
        dbx_jmp.start_log("w")
    elif not logging.getLogger().handlers:
        dbx_jmp.start_log("a")
    dbxOk = 1
except ImportError:
    dbxOk = 0
]\" ) );
	Python Get( dbxOk );
);

// Returns 1 when the Python packages are ready, installing them if the user agrees.
dbx:ensurePython = Function( {fresh}, {answer},
	If( dbx:loadPython( fresh ), Return( 1 ) );
	answer = New Window( "Databricks Connector", <<Modal,
		Text Box( "The Databricks Python packages are not installed in JMP's Python environment." ),
		Text Box( "Install them now? (databricks-sdk, databricks-sql-connector, pyarrow; about a minute)" ),
		H List Box( Button Box( "OK" ), Button Box( "Cancel" ) )
	);
	If( answer["Button"] != 1, Return( 0 ) );
	Python Submit( "import jmputils; jmputils.jpip('install', 'databricks-sdk databricks-sql-connector[pyarrow]')" );
	If( dbx:loadPython( fresh ), Return( 1 ) );
	New Window( "Databricks Connector", <<Modal, Text Box( "Installing the Databricks packages failed. See the JMP log for pip output." ) );
	0;
);

// Call dbx_jmp.<fn>(**args). Returns the result, or Empty() after showing the error (also kept in dbx:lastError).
dbx:call = Function( {fn, args = Associative Array()}, {dbxArgs, res},
	dbxArgs = As JSON Expr( args );
	Python Send( dbxArgs );
	// del: the args can hold a PAT, so don't leave them in a Python global
	Python Submit( Eval Insert( "dbxRes = dbx_jmp.dispatch('^fn^', dbxArgs); del dbxArgs" ) );
	res = Parse JSON( Python Get( dbxRes ) );
	If( res["ok"],
		res["data"],
		dbx:lastError = res["error"];
		dbx:setStatus( res["error"], 1 );
		Empty();
	);
);

dbx:setStatus = Function( {msg, isError = 0},
	// No window (or it was closed), e.g. during a table refresh: write to the JMP log instead.
	Try(
		dbx:status << Set Text( msg );
		dbx:status << Text Color( If( isError, dbx:lava, dbx:muted ) );
		Wait( 0 ); // repaint before the next blocking Python call
	,
		Write( "\!nDatabricks Connector: " || msg )
	);
);

// Date formats and provenance, shared by import and refresh. Python returns which columns are dates.
dbx:finishTable = Function( {dt, r},
	For Each( {c}, r["date_cols"], Column( dt, c ) << Format( "yyyy-mm-dd", 10 ) );
	For Each( {c}, r["datetime_cols"], Column( dt, c ) << Format( "yyyy-mm-ddThh:mm:ss", 19 ) );
);
